  m_Name: 
  m_EditorClassIdentifier: 
  lines:
  - text: "Princess, the road ahead feels\u2026 wrong. Stay close."
    speaker: 0
  - text: "You worry too much. It\u2019s just a quiet forest..."
    speaker: 1
  - text: QUIET?! Not anymore! Hehehe!
    speaker: 2
  - text: A goblin? What do you want?
    speaker: 0
  - text: "You, obviously! Boss said bring the \u201Csparkly one\u201D!"
    speaker: 2
  - text: Over my dead body.
    speaker: 0
  - text: That can be arranged! Boys, grab her!
    speaker: 2
  - text: Knight!
    speaker: 1
